import sqlite3
import random
import math

# ==========================
# STEP 1: Generate Random Cities and Store in SQLite
# ==========================

DB_NAME = "tsp.db"

def create_database():
    """Creates a database with two tables: cities and distance_matrix"""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    # Create cities table
    cursor.execute("DROP TABLE IF EXISTS cities")
    cursor.execute("""
        CREATE TABLE cities (
            id INTEGER PRIMARY KEY,
            x REAL,
            y REAL
        )
    """)

    # Create distance matrix table
    cursor.execute("DROP TABLE IF EXISTS distance_matrix")
    cursor.execute("""
        CREATE TABLE distance_matrix (
            city1 INTEGER,
            city2 INTEGER,
            distance REAL,
            PRIMARY KEY (city1, city2),
            FOREIGN KEY (city1) REFERENCES cities(id),
            FOREIGN KEY (city2) REFERENCES cities(id)
        )
    """)

    conn.commit()
    conn.close()

def generate_random_cities(n):
    """Generates n random cities with (x, y) coordinates and stores them in SQLite."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    cities = []
    for i in range(n):
        x, y = random.uniform(0, 100), random.uniform(0, 100)  # Cities in 100x100 space
        cursor.execute("INSERT INTO cities (x, y) VALUES (?, ?)", (x, y))
        cities.append((i+1, x, y))  # Store (id, x, y)

    conn.commit()
    conn.close()
    return cities  # Return for distance calculation

def calculate_distance(city1, city2):
    """Calculates Euclidean distance between two cities."""
    return math.sqrt((city1[1] - city2[1])**2 + (city1[2] - city2[2])**2)

def generate_distance_matrix(cities):
    """Computes distance between each pair of cities and stores it in SQLite."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    for i in range(len(cities)):
        for j in range(len(cities)):
            if i != j:
                dist = calculate_distance(cities[i], cities[j])
                cursor.execute("INSERT INTO distance_matrix (city1, city2, distance) VALUES (?, ?, ?)", 
                               (cities[i][0], cities[j][0], dist))

    conn.commit()
    conn.close()

# ==========================
# STEP 2: Graph Class to Load Data
# ==========================

class Graph:
    """Graph class to store cities and distance matrix as an adjacency matrix."""
    
    def __init__(self, db_name):
        self.db_name = db_name
        self.cities = []
        self.adjacency_matrix = []
        self.load_data()

    def load_data(self):
        """Loads cities and distance matrix from SQLite into memory."""
        conn = sqlite3.connect(self.db_name)
        cursor = conn.cursor()

        # Load cities
        cursor.execute("SELECT id, x, y FROM cities")
        self.cities = cursor.fetchall()  # List of (id, x, y)

        # Create empty adjacency matrix
        n = len(self.cities)
        self.adjacency_matrix = [[0] * n for _ in range(n)]

        # Load distances into matrix
        cursor.execute("SELECT city1, city2, distance FROM distance_matrix")
        for city1, city2, distance in cursor.fetchall():
            self.adjacency_matrix[city1 - 1][city2 - 1] = distance  # Convert 1-based ID to 0-based index

        conn.close()

    def print_matrix(self):
        """Prints the adjacency matrix (distance matrix)."""
        for row in self.adjacency_matrix:
            print(row)

# ==========================
# RUN EVERYTHING
# ==========================

if __name__ == "__main__":
    create_database()  # Step 1: Create tables
    cities = generate_random_cities(5)  # Step 2: Generate 5 random cities
    generate_distance_matrix(cities)  # Step 3: Compute distances

    graph = Graph(DB_NAME)  # Step 4: Load data into Graph class
    graph.print_matrix()  # Step 5: Print adjacency matrix
